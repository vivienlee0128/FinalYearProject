# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tester
# API_KEY=replace-with-a-long-random-string
# EXPO_PUBLIC_API_BASE_URL=http://192.168.100.25:8080/api/attendance
# EXPO_PUBLIC_STUDENT_ID=S123456

# Expo app .env — lives in your attendance-dashboard (Expo) project root,
# next to App.js. Restart `expo start -c` after editing this file.

# Your computer's LAN IP (not "localhost" — a phone/emulator can't
# reach your machine's localhost), plus the PORT from the API's .env.
EXPO_PUBLIC_API_BASE_URL=http://192.168.100.25:6521/api
#Wifi Swinburne
# EXPO_PUBLIC_API_BASE_URL=http://172.17.81.226:6521/api


# Must match API_KEY in attendance-api/.env exactly (same string,
# both sides — this is how the server tells your app apart from
# anyone else hitting the endpoint).
EXPO_PUBLIC_API_KEY=replace-with-a-long-random-string

# One of the student IDs seeded in your database.
EXPO_PUBLIC_STUDENT_ID=