# API server .env — lives in your attendance-api project root,
# next to server.js. Never commit this file to git.

# Your Postgres connection string. Swap in the real username,
# password, host, and database name for your Docker container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tester

# Must match EXPO_PUBLIC_API_KEY in the Expo app's .env exactly
# (same string, both sides).
API_KEY=replace-with-a-long-random-string

# Port this server listens on. Must match the port used in
# EXPO_PUBLIC_API_URL on the Expo side.
PORT=6521