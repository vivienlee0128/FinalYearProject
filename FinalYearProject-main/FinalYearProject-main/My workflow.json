      "id": "477d3ff7-b570-4e25-a002-bae5579011bc",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "const pages = $input.all();\n\nconst targetSisId =\n  $('Code in JavaScript').first().json.receivedSisId;\n\nif (!targetSisId) {\n  throw new Error('Student SIS ID was not received from the webhook');\n}\n\nlet student = null;\n\nfor (const page of pages) {\n  const users = page.json.results ?? [];\n\n  student = users.find(\n    user => String(user.sis_id) === String(targetSisId)\n  );\n\n  if (student) {\n    break;\n  }\n}\n\nif (!student) {\n  return [\n    {\n      json: {\n        found: false,\n        sisId: targetSisId,\n        pagesSearched: pages.length\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      found: true,\n      student: {\n        qwicklyId: student.id,\n        firstName: student.first_name,\n        lastName: student.last_name,\n        email: student.email,\n        sisId: student.sis_id,\n        lmsId: student.lms_id\n      },\n      pagesSearched: pages.length\n    }\n  }\n];"
      },
