{
  "expo": {
    "name": "Swinburne Student Attendance",
    "slug": "my-new-app",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/attendance-app-icon.png",
    "scheme": "mynewapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/attendance-app-icon.png",
      "bundleIdentifier": "com.benny24.mynewapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is needed to scan a lecturer attendance QR code."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/branding/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.benny24.mynewapp",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/attendance-app-icon.png",
          "imageWidth": 110
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Swinburne Student Attendance to scan lecturer QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d76e4aaa-6f71-4792-840a-9c8c265701d2"
      }
    },
    "owner": "benny24"
  }
}
